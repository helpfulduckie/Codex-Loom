// Jest Snapshot v1, https://goo.gl/fbAQLP

exports[`pathological fixture a body key no field reads, deduped across leaves 1`] = `
"WARN CL0630 compile.cl.yaml
  branch "north" resolves no opening: and no adventureDescription:, so Velvet Lattice would start this leaf with an empty prompt. Give the branch an opening:, or one an ancestor passes down.
WARN CL0631 compile.cl.yaml
  branch "north" resolves no aiInstructions:. Velvet Lattice writes an empty-string AI Instructions on AID's side for it, and an empty string suppresses AID's model-default instructions rather than falling back to them — the leaf plays with none at all. Give the branch an aiInstructions:, or one an ancestor passes down.
WARN CL0630 compile.cl.yaml
  branch "south" resolves no opening: and no adventureDescription:, so Velvet Lattice would start this leaf with an empty prompt. Give the branch an opening:, or one an ancestor passes down.
WARN CL0631 compile.cl.yaml
  branch "south" resolves no aiInstructions:. Velvet Lattice writes an empty-string AI Instructions on AID's side for it, and an empty string suppresses AID's model-default instructions rather than falling back to them — the leaf plays with none at all. Give the branch an aiInstructions:, or one an ancestor passes down.
WARN CL0426 Codex/items.cl.yaml
  body key "strength" on item "Alba" is read by no field in template "Person" and no declaration names it — its content is dropped from the compiled card.
WARN CL0427 Codex/items.cl.yaml
  body key "homeland" on item "Cairn" is a declared field but group \`origin\`, which template "Person" does not include — its content is dropped from the compiled card.
WARN CL0428 templates/fields.cl.yaml
  field "deadField" is declared in the field table but no template names it, directly or through a group."
`;

exports[`pathological fixture a committed manifest that disagrees with the config and the disk 1`] = `
"WARN CL0113
  Library "alpha" has no entry in manifest.json.
WARN CL0114
  Library "beta": snapshot/beta/extra.yaml has no entry in the manifest.
WARN CL0630 compile.cl.yaml
  branch "(root)" resolves no opening: and no adventureDescription:, so Velvet Lattice would start this leaf with an empty prompt. Give the branch an opening:, or one an ancestor passes down.
WARN CL0631 compile.cl.yaml
  branch "(root)" resolves no aiInstructions:. Velvet Lattice writes an empty-string AI Instructions on AID's side for it, and an empty string suppresses AID's model-default instructions rather than falling back to them — the leaf plays with none at all. Give the branch an aiInstructions:, or one an ancestor passes down."
`;

exports[`pathological fixture a hand-edited snapshot file aborts the load 1`] = `
"ERROR CL0115
  Library "main": snapshot/main/thing.yaml does not match its manifest hash — it was hand-edited since the last --snapshot."
`;

