/test/output
/node_modules

# Machine-local Claude Code permissions. The shared half is .claude/settings.json.
/.claude/settings.local.json

# The golden fixtures are real scenario projects, so they live in a separate private repo
# rather than in this tree. Clone it here to run the golden suite; without it,
# __tests__/fixtures/golden.test.js skips and the rest of the suite is unaffected.
#
#   git clone https://github.com/helpfulduckie/Codex-Loom-Fixtures.git goldenFixtures
#
/goldenFixtures/

# The pathological fixture's harness compiles into a temp copy, so an
# out/ tree here only appears if the CLI was pointed at the fixture directly.
/__tests__/fixtures/pathological/*/out/

# The .skill bundle is a zip of skill/aid-codex-loom/ — a build output, not source.
# Regenerate it before uploading; the unpacked tree is the thing to edit.
/skill/*.skill
