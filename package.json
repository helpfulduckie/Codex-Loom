{
  "name": "codex-loom",
  "version": "3.2.0",
  "description": "Codex Loom — compiles YAML card definitions into Velvet Lattice story card format for AI Dungeon scenarios.",
  "main": "./src/compile.js",
  "bin": {
    "codex-loom": "./src/compile.js"
  },
  "scripts": {
    "test": "jest",
    "test:unit": "jest __tests__/unit",
    "test:integration": "jest __tests__/integration",
    "test:coverage": "jest --coverage",
    "compile": "node src/compile.js test/compile.yaml"
  },
  "dependencies": {
    "js-yaml": "^4.1.1"
  },
  "devDependencies": {
    "jest": "^29.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js"
    ]
  }
}