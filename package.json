{
  "name": "codex-loom",
  "version": "4.0.0",
  "description": "Codex Loom — compiles YAML card definitions into Velvet Lattice story card format for AI Dungeon scenarios.",
  "main": "./src/compile.js",
  "bin": {
    "codex-loom": "./src/cli.js"
  },
  "scripts": {
    "test": "jest",
    "test:unit": "jest __tests__/unit",
    "test:integration": "jest __tests__/integration",
    "test:fixtures": "jest __tests__/fixtures",
    "test:coverage": "jest --coverage",
    "compile": "node src/cli.js test/compile.yaml"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "jest": "^29.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js"
    ]
  }
}
